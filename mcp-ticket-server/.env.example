# Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Coinbase Commerce Configuration (Optional - for real payments)
# Get your API key from: https://commerce.coinbase.com/dashboard/settings
COINBASE_COMMERCE_API_KEY=your_coinbase_api_key_here

# Blockchain Configuration (Optional - for real blockchain integration)
PAYMENT_WALLET_PRIVATE_KEY=your_wallet_private_key_here
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/your-api-key

# MCP Configuration
MCP_SERVER_NAME=ticket-server
MCP_SERVER_VERSION=1.0.0

# Mock Data (for development)
USE_MOCK_PAYMENTS=true
