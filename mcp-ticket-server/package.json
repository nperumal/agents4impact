{
  "name": "mcp-ticket-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for ticket management operations including events, venues, and ticket purchasing with blockchain integration",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "start": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tickets",
    "events",
    "venues",
    "blockchain",
    "usdc",
    "coinbase-commerce",
    "fastmcp"
  ],
  "author": "Agents4Impact Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nperumal/agents4impact.git",
    "directory": "mcp-ticket-server"
  },
  "bugs": {
    "url": "https://github.com/nperumal/agents4impact/issues"
  },
  "homepage": "https://github.com/nperumal/agents4impact#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.10.0",
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ]
}
